extends SceneTree

const NUMERICS = preload("res://data/combat_stage/combat_numerics.tres")
const TIERS = preload("res://data/combat_stage/tier_catalog.tres")
const BARRAGE_AREA_SCRIPT = preload("res://systems/barrage_generation/barrage_area.gd")
const BARRAGE_VIEW_SCRIPT = preload("res://systems/barrage_generation/barrage_view.gd")
const ORACLE_FLOW_SCRIPT = preload("res://core/contradiction_oracle/contradiction_oracle_flow.gd")

func _initialize() -> void:
    assert(is_equal_approx(NUMERICS.initial_player_pk, 0.5))
    assert(is_equal_approx(NUMERICS.base_pullback_speed_pk_per_second, 0.0008))
    assert(is_equal_approx(NUMERICS.pc_aim_radius_px, 72.0))
    assert(is_equal_approx(NUMERICS.charge_time_seconds, 0.8))
    assert(is_equal_approx(NUMERICS.normal_hit_pk_by_strength[1], 0.004))
    assert(is_equal_approx(NUMERICS.normal_hit_pk_by_strength[2], 0.007))
    assert(is_equal_approx(NUMERICS.normal_hit_pk_by_strength[3], 0.012))
    assert(is_equal_approx(NUMERICS.contradiction_break_viewer_gain, 80.0))
    assert(is_equal_approx(NUMERICS.contradiction_break_like_gain, 40.0))
    assert(is_equal_approx(NUMERICS.oracle_confirmation_viewer_gain, 40.0))
    assert(is_equal_approx(NUMERICS.oracle_confirmation_like_gain, 20.0))
    assert(is_equal_approx(NUMERICS.contradiction_break_boost_duration_seconds, 2.0))
    assert(is_equal_approx(NUMERICS.oracle_confirmation_boost_duration_seconds, 2.0))
    assert(is_equal_approx(NUMERICS.foreground_local_animation_intensity, 0.2))
    assert(NUMERICS.foreground_outline_width_px == 2)
    assert(NUMERICS.foreground_outline_color.to_html(false) == Color("#30272F").to_html(false))
    assert(NUMERICS.repeat_text_color.to_html(false) == Color("#888888").to_html(false))
    var reward: Dictionary = NUMERICS.get_normal_hit_reward(3, "orthodox")
    assert(is_equal_approx(float(reward["pk_delta"]), 0.012))
    assert(int(reward["tendency_delta"]) == 10)
    var tier_two: CombatStageTierConfig = TIERS.get_tier_config(2)
    assert(tier_two != null)
    assert(is_equal_approx(tier_two.straight_motion_weight, 50.0))
    assert(is_equal_approx(tier_two.curved_motion_weight, 25.0))
    assert(is_equal_approx(tier_two.speed_change_motion_weight, 15.0))
    assert(is_equal_approx(tier_two.wandering_motion_weight, 10.0))
    var live := LiveSessionData.new()
    live.configure_formal_rules(NUMERICS)
    live.initialize_session(0)
    live.start_short_boost(LiveSessionData.BoostEvent.CONTRADICTION_BREAK,
        NUMERICS.contradiction_break_viewer_gain, NUMERICS.contradiction_break_like_gain,
        NUMERICS.contradiction_break_boost_duration_seconds)
    live.advance_short_boosts(2.0)
    assert(live.viewer_count == 80)
    assert(live.like_count == 40)
    print("SHEET-A PASS production 06/08/09 Resource values and configured live boost")
    quit(0)
