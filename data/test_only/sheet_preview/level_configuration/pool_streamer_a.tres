appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_36"]
script = ExtResource("2_speech")
original_sentence_id = "w_0036"
text = "祂给我能力，显然希望我使用它"
tendency_id = "heretical"
strength = 2
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_37"]
script = ExtResource("2_speech")
original_sentence_id = "w_0037"
text = "你反对我，就是在反对祂的安排"
