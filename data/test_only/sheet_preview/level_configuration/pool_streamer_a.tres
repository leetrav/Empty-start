appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_24"]
script = ExtResource("2_speech")
original_sentence_id = "w_0024"
text = "祂说要宽恕，可没说要宽恕所有人"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_25"]
script = ExtResource("2_speech")
original_sentence_id = "w_0025"
text = "神既然选了我，规则自然可以灵活一点"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_26"]
script = ExtResource("2_speech")
original_sentence_id = "w_0026"
text = "经文没有写反对，那就等于默许"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_27"]
script = ExtResource("2_speech")
original_sentence_id = "w_0027"
text = "我只是替祂把模糊的地方说清楚"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_28"]
script = ExtResource("2_speech")
original_sentence_id = "w_0028"
text = "祂说人人平等，但总有人更接近祂"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_29"]
script = ExtResource("2_speech")
original_sentence_id = "w_0029"
text = "我当然服从神，只是解释权归我"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_30"]
script = ExtResource("2_speech")
original_sentence_id = "w_0030"
text = "神不会偏爱我，祂只是更常听我的"
tendency_id = "heretical"
strength = 1
appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_31"]
script = ExtResource("2_speech")
original_sentence_id = "w_0031"
text = "如果结果是神圣的，手段可以晚点讨论"
