appearance_weight = 1

[sub_resource type="Resource" script_class="LevelSpeech" id="Speech_33"]
script = ExtResource("2_speech")
original_sentence_id = "w_0033"
text = "祂会惩罚罪人，我只是帮祂节省时间"
tendency_id = "heretical"
